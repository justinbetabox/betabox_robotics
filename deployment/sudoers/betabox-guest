# Betabox Guest workspace administration
#
# Permit the classroom administrator to run only the exact Guest
# workspace provision and reset commands without a password.

@SERVICE_USER@ ALL=(root) NOPASSWD: /opt/betabox/venv/bin/betabox guest provision
@SERVICE_USER@ ALL=(root) NOPASSWD: /opt/betabox/venv/bin/betabox guest reset
@SERVICE_USER@ ALL=(root) NOPASSWD: /opt/betabox/venv/bin/betabox-auth-check
