[Unit]
Description=Betabox video streaming service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=/opt/libs/betabox_robotics
ExecStart=/opt/betabox/venv/bin/betabox video --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
